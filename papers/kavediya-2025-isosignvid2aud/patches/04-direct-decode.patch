+def decode_clip(video_path: str | Path, end_sec: float) -> torch.Tensor:
+    """Same tensor as EncodedVideo.from_path(video_path).get_clip(0, end_sec)["video"],
+    decoded by the same PyAV/FFmpeg without pytorchvideo's per-frame overhead."""
+    with av.open(str(video_path)) as container:
+        stream = container.streams.video[0]
+        start = stream.start_time if stream.start_time is not None else 0.0
+        start_pts = secs_to_pts(0, stream.time_base, start, round_mode="ceil")
+        end_pts = secs_to_pts(end_sec, stream.time_base, start, round_mode="ceil")
+        frames = {}
+        for frame in container.decode(video=0):
+            if start_pts <= frame.pts < end_pts:
+                frames[frame.pts] = frame.to_ndarray(format="rgb24")
+            elif frame.pts >= end_pts:
+                break
+    if not frames:
+        raise RuntimeError(f"No video found within 0 and {end_sec} seconds")
+    video = np.stack([frames[pts] for pts in sorted(frames)])
+    return torch.from_numpy(video).permute(3, 0, 1, 2).to(torch.float32)
+
