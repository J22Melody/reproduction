+def save_resume_state(path, epoch, model, optimizers, schedulers, early_stopping, extra) -> None:
+    state = {
+        "epoch": epoch,
+        "model": model.state_dict(),
+        "optimizers": [o.state_dict() for o in optimizers],
+        "schedulers": [s.state_dict() for s in schedulers],
+        "early_stopping": dict(vars(early_stopping)),
+        "extra": extra,
+        "rng": (torch.get_rng_state(), torch.cuda.get_rng_state_all(), random.getstate(), np.random.get_state()),
+    }
+    tmp = Path(str(path) + ".tmp")
+    torch.save(state, tmp)
+    tmp.replace(path)
+
+
+def load_resume_state(path, model, optimizers, schedulers, early_stopping, device):
+    """Restore the state saved after the last finished epoch; return (next epoch, extra)."""
+    if not Path(path).exists():
+        return 0, None
+    # RNG states must stay on the CPU; load_state_dict moves weights and optimizer state.
+    state = torch.load(path, weights_only=False, map_location="cpu")
+    model.load_state_dict(state["model"])
+    for o, s in zip(optimizers, state["optimizers"]):
+        o.load_state_dict(s)
+    for sch, s in zip(schedulers, state["schedulers"]):
+        sch.load_state_dict(s)
+    vars(early_stopping).update(state["early_stopping"])
+    torch_rng, cuda_rng, python_rng, numpy_rng = state["rng"]
+    torch.set_rng_state(torch_rng)
+    torch.cuda.set_rng_state_all(cuda_rng)
+    random.setstate(python_rng)
+    np.random.set_state(numpy_rng)
+    logging.info(f"Resumed from {path} after epoch {state['epoch'] + 1}")
+    return state["epoch"] + 1, state["extra"]
