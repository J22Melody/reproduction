+def _pytorchvideo_duration(container, video_path) -> float:
+    """EncodedVideoPyAV.duration: the longer of the video and audio stream durations from the
+    header, or the last decoded video frame's time when neither header gives one."""
+    from pytorchvideo.data.utils import pts_to_secs
+
+    video = container.streams.video[0]
+    video_start = video.start_time if video.start_time is not None else 0.0
+    durations = []
+    if video.duration is not None:
+        durations.append(pts_to_secs(video.duration, video.time_base, video_start))
+    if container.streams.audio and container.streams.audio[0].duration is not None:
+        audio = container.streams.audio[0]
+        audio_start = audio.start_time if audio.start_time is not None else 0.0
+        durations.append(pts_to_secs(audio.duration, audio.time_base, audio_start))
+    if durations:
+        return max(durations)
+    with av.open(str(video_path)) as again:
+        last = max(frame.pts for frame in again.decode(video=0))
+    return pts_to_secs(last, video.time_base, video_start)
+
